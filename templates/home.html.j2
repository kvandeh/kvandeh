{% block scripts %}
<script>

  // Reveal on scroll, off for reduced-motion users.
  (function () {
    var els = document.querySelectorAll('.reveal');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('in'); }); return;
    }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();

  // Conversion events, only if GoatCounter is present; silent otherwise.
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-track]');
    if (!t || !window.goatcounter || !window.goatcounter.count) return;
    window.goatcounter.count({ path: 'event/' + t.getAttribute('data-track'), title: t.getAttribute('data-track'), event: true });
  });
</script>

<!-- Cookieless analytics, no banner. TODO: replace YOURCODE from a free goatcounter.com site. -->
<script data-goatcounter="https://YOURCODE.goatcounter.com/count" async src=".//gc.zgo.at/count.js"></script>
{% endblock %}
